# The image copies *.js/*.mjs wholesale so a new runtime module can never be forgotten
# (that omission has shipped three times). This file is the other half of that trade: it
# keeps the wholesale copy from dragging the dev-only tree into a production image.
node_modules
data
test
scripts
*.test.js
*.test.mjs
*.sh
openapi.yaml
Dockerfile
.dockerignore
