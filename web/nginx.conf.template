# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Sent on every response below. NOTE: an `add_header` inside a location replaces the whole
    # inherited set rather than adding to it, so the two locations further down that set their
    # own Cache-Control have to repeat these three. Deliberately not a full Content-Security-
    # Policy: only frame-ancestors, which no part of the app depends on. TLS, HSTS and any
    # stricter policy stay the reverse proxy's job (see SECURITY.md).
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # API → backend container.
    # `^~` so this prefix beats the regex locations below: without it a request for a path such
    # as /api/anything.json would be matched by the \.(js|css|json|html)$ block instead and be
    # looked for on disk rather than proxied.
    location ^~ /api/ {
        # nginx's default is 1m, which sits BELOW the API's own limits — 5m for an ordinary
        # request and 16m for the state sync, which carries a whole training history. A sync
        # payload above nginx's limit and below node's is refused here and never reaches node --
        # and nginx answers a 413 with an HTML error page, so the client's api() helper fails
        # trying to parse it as JSON and reports something that has nothing to do with the size.
        # The app state grows with every
        # logged workout, so this is a cliff a long-standing user walks into, not a theoretical
        # one. Keep this value ABOVE whatever node enforces: node's limit is the one meant to be
        # hit, because node can answer it in JSON that the client understands.
        #
        # That invariant is why this is no longer 16m. Coach exercise demos stream through here
        # and the API caps them at MEDIA_MAX_VIDEO_MB (90 by default), so 16m put nginx BACK
        # below node -- every demo over 16 MB would have hit the HTML-413 cliff this comment was
        # written about, on the stack the repo itself ships. Rendered from the environment so the
        # two move together; raise NGINX_MAX_BODY whenever MEDIA_MAX_VIDEO_MB goes past it.
        client_max_body_size ${NGINX_MAX_BODY};
        # Resolved per request through Docker's DNS, not once at start-up: nginx otherwise pins
        # the api container's IP when it boots, and a recreated api (new IP) means 502 on every
        # /api call until web is restarted too (issue #16). The variable is what makes nginx
        # re-resolve; lowercase so the entrypoint's envsubst leaves it alone.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream http://${BACKEND}:${PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # $remote_addr, NOT $proxy_add_x_forwarded_for: the latter APPENDS to whatever the client
        # sent, and the API reads the first entry — so a client could put any address it liked in
        # front of its own and choose what the activity log recorded about it. Overwriting is what
        # makes the header mean anything.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Same reasoning, and the API trusts this one FIRST. Empty by default, which drops the
        # header entirely, so a direct client cannot forge it. Cloudflare users set
        # CF_CONNECTING_IP=$http_cf_connecting_ip to let the real one through — correct only when
        # Cloudflare is genuinely in front, because that is what overwrites a client-supplied one.
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
    }

    # Media uploads and playback. Identical proxying to /api/ above except for two directives,
    # and it is those two that need a location of their own.
    #
    # `^~` and the longer prefix make this win over /api/ for these paths; nginx picks the
    # longest matching prefix location, so ordering in this file is not what decides it.
    #
    # DUPLICATION IS DELIBERATE. proxy_set_header is inherited from the enclosing level only by a
    # location that sets NONE of its own -- set one and every inherited header disappears. So the
    # choice is to repeat the block or to hoist all of them to server level, and hoisting changes
    # what every other location receives. Repeating it is the change whose blast radius is one
    # location. Anything edited above must be edited here too; CI checks that the two agree.
    location ^~ /api/media/ {
        client_max_body_size ${NGINX_MAX_BODY};
        # The reason this location exists. With buffering on -- nginx's default -- nginx reads the
        # ENTIRE upload to a temp file before opening a connection upstream, so the API cannot see
        # the first bytes until the last ones have arrived. That silently defeats rejecting a file
        # on its header: a 200 MB HEIC would be spooled to the web container's disk in full before
        # the API is told it exists, and the refusal it eventually sends is one the user waited
        # for the whole upload to receive.
        proxy_request_buffering off;
        # Playback is a stream, not a document. Buffering the response makes nginx read ahead into
        # its own buffers before answering a range request, which is wasted work when a <video>
        # seek will abandon the response a moment later.
        proxy_buffering off;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $media_upstream http://${BACKEND}:${PORT};
        proxy_pass $media_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP "${CF_CONNECTING_IP}";
        # An upload is slow by nature and a large one on a domestic uplink outlasts the 60s
        # default, which would surface as a 504 halfway through with nothing written.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # The two above govern nginx<->API. This one governs nginx->BROWSER, and it matters here
        # only because this location also streams downloads: with proxy_buffering off, nginx
        # blocks on the write to the client as soon as the browser stops draining, and a viewer
        # who pauses a buffered demo for over a minute would have the response cut off underneath
        # them. Players usually recover by re-issuing a range request, which is precisely why this
        # would be reported as "it stutters sometimes" and never traced back to here.
        send_timeout 300s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
