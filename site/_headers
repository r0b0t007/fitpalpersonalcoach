# Cloudflare Pages — security + caching headers.
# Hashless static site: HTML must revalidate so a deploy is visible immediately,
# while fingerprint-free assets (images, css, js) are safe to cache a day and
# revalidate. Adjust max-age if you start versioning asset filenames.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/img/*
  Cache-Control: public, max-age=86400

/styles.css
  Cache-Control: public, max-age=86400

/site.js
  Cache-Control: public, max-age=86400
