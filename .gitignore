# Exercise media — fetched by scripts/fetch-media.sh
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
# Claude Code's own directory is local state — EXCEPT the two files below, which are repo
# tooling every checkout should get. git cannot re-include a file whose parent directory is
# excluded, so this ignores the contents rather than the directory itself.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
.agents/

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# design-sync (claude.ai/design) scratch — regenerated per run
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# impeccable critique snapshots (local tooling output)
.impeccable/

# Build output for site-coach/. Generated by scripts/build-site-coach.mjs; the source of
# truth is site-coach/ itself. CI builds this fresh on every deploy.
/dist/

# Lighthouse reports and the extracted baseline tree used for before/after perf runs.
/.perf/
