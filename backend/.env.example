APP_NAME="FitPal Coach"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Mail carries the coaches' sign-in links and address confirmations (spec §4a). `log` writes them
# to storage/logs, which is right on a laptop; a live instance sends through Resend:
#   MAIL_MAILER=resend  RESEND_API_KEY=re_…  MAIL_FROM_ADDRESS=no-reply@fitpal.ma
# (the domain verified in Resend; fitpal:check-config says what is missing). Resend's HTTP API, not
# its SMTP relay: errors come back as Resend's own sentences in the log, and the call has time limits
# (app/Mail/ResendMailer.php).
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- FitPal Coach (see config/fitpal.php and docs/SELF_HOSTING.md; names kept from the Node API) ---
RP_ID=localhost
ORIGIN=http://localhost:5173
RP_NAME="FitPal Coach"
INVITE_ONLY=0
# The first account on an INVITE_ONLY instance signs up with this code and becomes the admin.
# At least 16 characters; inert once any account exists. Clear it after the first sign-up.
BOOTSTRAP_CODE=
ALLOW_GUEST=1
SELF_SERVE_COACH=0
# Account ids (comma-separated) that are admins whatever their row says: how the first operator
# bootstraps. Find yours in the app under Account, or in the users table.
ADMIN_UIDS=
# 64 hex characters. In production: the contents of the old DATA_DIR/secret file.
SESSION_SECRET=
SESSION_DAYS=90
# Media files live here, outside the document root: <DATA_DIR>/media/ex and /media/photo.
# Unset (or blank) means storage/app/fitpal.
#DATA_DIR=/home/<account>/fitpal-coach-data
MEDIA_MAX_VIDEO_MB=90
MEDIA_MAX_PHOTO_MB=12
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Creem. All unset = billing off (every coach entitled, nothing enforced).
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Empty: test-api.creem.io for a creem_test_ key, api.creem.io otherwise.
CREEM_API_BASE=
CREEM_PRODUCTS=
AUDIT_LOG=1
AUDIT_MAX=5000
AUDIT_DAYS=90
AUDIT_IP=off
